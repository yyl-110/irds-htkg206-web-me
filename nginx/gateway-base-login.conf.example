# Key 网关 SSO — Nginx 配置（39.106.130.85 / listen 80）
#
# 集成登录跳转地址保持不变：http://39.106.130.85/base/login.jsp
# 后端实际处理路径（与 curl 测试 /Api/system-service/.../gateway/login 一致）：
#   /system-service/system/auth/gateway/login-entry
#
# ========== 粘贴在 listen 80 server 中，location /Api 之后、location / 之前 ==========

location = /base/login.jsp {
    proxy_pass http://gateway/system-service/system/auth/gateway/login-entry;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header dnname $http_dnname;
    proxy_set_header clientip $http_clientip;
    proxy_connect_timeout 60s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
}

# ========== 部署后按顺序自检（在服务器上执行）==========
#
# 1) 路由是否通（应返回 {"code":200,"data":"gateway-auth-ok",...}）
# curl -s "http://127.0.0.1/Api/system-service/system/auth/gateway/ping"
#
# 2) HTML 入口是否通（应返回 HTML，不是 Whitelabel 404）
# curl -i "http://127.0.0.1/Api/system-service/system/auth/gateway/login-entry" \
#   -H "dnname: CN=admin, T=320106198807154039" -H "clientip: 127.0.0.1"
#
# 3) 再走对外地址
# curl -i "http://39.106.130.85/base/login.jsp" \
#   -H "dnname: CN=admin, T=320106198807154039" -H "clientip: 127.0.0.1"
#
# ========== Nacos Gateway 白名单 no-auth-url ==========
#   - /system-service/system/auth/gateway/**
